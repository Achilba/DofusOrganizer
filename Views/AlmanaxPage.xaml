<UserControl x:Class="DofusTeamOrganizer.Views.AlmanaxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ArrowBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="BigBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="RowBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre + progression -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Almanax" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding WeekLabel}" Style="{StaticResource PageSub}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Border Width="150" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding WeekCounter}" FontFamily="{StaticResource BodyXB}"/>
                            <TextBlock Text="Semaine" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding WeekPct, Mode=OneWay}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="150" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding YearCounter}" FontFamily="{StaticResource BodyXB}"/>
                            <TextBlock Text="{Binding YearLabel}" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Meter}" Foreground="{StaticResource Accent}" Value="{Binding YearPct, Mode=OneWay}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Navigation semaine -->
        <DockPanel Grid.Row="1" Margin="0,0,0,14" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource ArrowBtn}" Command="{Binding PrevCommand}" IsEnabled="{Binding CanPrev}" Margin="0,0,8,0" ToolTip="Semaine précédente">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoChevronLeft}" Stroke="{StaticResource Text}" StrokeThickness="2.5" Width="18" Height="18"/>
            </Button>
            <Border DockPanel.Dock="Left" MinWidth="220" Height="44" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
                <TextBlock Text="{Binding WeekShort}" FontFamily="{StaticResource BodyXB}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Button DockPanel.Dock="Left" Style="{StaticResource ArrowBtn}" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" Margin="0,0,8,0" ToolTip="Semaine suivante">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoChevronRight}" Stroke="{StaticResource Text}" StrokeThickness="2.5" Width="18" Height="18"/>
            </Button>
            <Button DockPanel.Dock="Left" Content="Aujourd'hui" Command="{Binding TodayCommand}" MinHeight="44" Padding="16,0"/>
            <Button DockPanel.Dock="Right" Command="{Binding ToggleViewCommand}" MinHeight="44" Padding="16,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonthView}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCalendar}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ViewButtonText}"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Boutons rapides (vue semaine) -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,14" Visibility="{Binding IsWeekView, Converter={StaticResource BoolVis}}">
            <Button Content="Tout à préparer" Command="{Binding AllTodoCommand}" Style="{StaticResource BigBtn}" BorderBrush="#4A5160" Margin="0,0,8,0"/>
            <Button Content="Tout préparé" Command="{Binding AllPrepCommand}" Style="{StaticResource BigBtn}" Background="Transparent" Foreground="{StaticResource WarnText}" BorderBrush="{StaticResource Warn}" Margin="0,0,8,0"/>
            <Button Content="Tout validé" Command="{Binding AllDoneCommand}" Style="{StaticResource BigBtn}" Background="{StaticResource Good}" Foreground="{StaticResource GoodDark}" BorderBrush="{StaticResource Good}" Margin="0,0,8,0"/>
            <Button Command="{Binding ZaapCommand}" Style="{StaticResource BigBtn}" Background="Transparent" Foreground="{StaticResource Accent}" BorderBrush="{StaticResource Accent}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCopy}" Stroke="{StaticResource Accent}" Margin="0,0,8,0"/>
                    <TextBlock Text="Zaap"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Légende -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0"><Ellipse Width="10" Height="10" Fill="{StaticResource Off}" Margin="0,0,6,0"/><TextBlock Text="À faire" Foreground="{StaticResource Muted}" FontSize="12.5"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0"><Ellipse Width="10" Height="10" Fill="{StaticResource Warn}" Margin="0,0,6,0"/><TextBlock Text="Ressource préparée" Foreground="{StaticResource Muted}" FontSize="12.5"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0"><Ellipse Width="10" Height="10" Fill="{StaticResource Good}" Margin="0,0,6,0"/><TextBlock Text="Validé" Foreground="{StaticResource Muted}" FontSize="12.5"/></StackPanel>
            <StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{StaticResource Bad}" Margin="0,0,6,0"/><TextBlock Text="Manqué" Foreground="{StaticResource Muted}" FontSize="12.5"/></StackPanel>
        </WrapPanel>

        <!-- Vue semaine -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsWeekView, Converter={StaticResource BoolVis}}">
            <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Bg}" BorderBrush="{Binding Border}" BorderThickness="1.5" CornerRadius="12" Margin="0,0,0,8" MinHeight="56">
                            <Grid>
                                <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource Accent}" CornerRadius="12,0,0,12" Margin="-1.5,-1.5,0,-1.5"
                                        Visibility="{Binding IsToday, Converter={StaticResource BoolVis}}"/>
                                <Grid Margin="18,6,12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DayName}" FontFamily="{StaticResource BodyXB}" FontSize="16"/>
                                            <TextBlock Text="AUJOURD'HUI" Foreground="{StaticResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsToday, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DateText}" Foreground="{StaticResource Muted}" FontSize="12.5"/>
                                            <Border BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="5" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasChip, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding ChipText}" Foreground="{Binding ChipBrush}" FontSize="11.5"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="{Binding Resource}" Command="{Binding CopyCommand}" Style="{StaticResource BtnFlat}" FontSize="14" Margin="0,2,10,2"
                                                ToolTip="Cliquer pour copier"/>
                                        <Border Background="{StaticResource KeyBg}" CornerRadius="6" Padding="8,2" Margin="0,2,10,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding QtyText}" FontFamily="{StaticResource BodyXB}" FontSize="12"/>
                                        </Border>
                                        <Border Width="18" Height="18" CornerRadius="9" BorderBrush="{StaticResource Muted}" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,2,10,2"
                                                Background="Transparent" ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="30000">
                                            <TextBlock Text="i" FontSize="11" FontFamily="{StaticResource BodyXB}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                            <Border.ToolTip>
                                                <StackPanel MaxWidth="300">
                                                    <TextBlock Text="MODIFICATEUR DU JOUR" Foreground="{StaticResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Bonus}" TextWrapping="Wrap" FontSize="12"/>
                                                </StackPanel>
                                            </Border.ToolTip>
                                        </Border>
                                        <Button Content="{Binding QuestText}" Command="{Binding QuestCommand}" Style="{StaticResource BtnGhost}" MinHeight="26" Padding="8,0" FontSize="12" Margin="0,2,0,2"
                                                Visibility="{Binding HasQuest, Converter={StaticResource BoolVis}}"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding PrepLabel}" Command="{Binding PrepCommand}" Margin="0,0,8,0"
                                                Visibility="{Binding ShowPrep, Converter={StaticResource BoolVis}}">
                                            
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RowBtn}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{StaticResource WarnText}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Warn}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrep}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Warn}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Valider" Command="{Binding DoneCommand}" Style="{StaticResource RowBtn}" Background="{StaticResource Good}" Foreground="{StaticResource GoodDark}"
                                                BorderBrush="{StaticResource Good}" Margin="0,0,8,0" Visibility="{Binding ShowDone, Converter={StaticResource BoolVis}}"/>
                                        <Button Content="Annuler" Command="{Binding UndoCommand}" Style="{StaticResource RowBtn}" Background="Transparent" Foreground="{StaticResource GoodText}"
                                                BorderBrush="{StaticResource Good}" Visibility="{Binding ShowUndo, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Vue calendrier -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsMonthView, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="0,0,10,0">
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Style="{StaticResource ArrowBtn}" Command="{Binding PrevMonthCommand}" IsEnabled="{Binding CanPrevMonth}" ToolTip="Mois précédent">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoChevronLeft}" Stroke="{StaticResource Text}" StrokeThickness="2.5" Width="18" Height="18"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ArrowBtn}" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanNextMonth}" ToolTip="Mois suivant">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoChevronRight}" Stroke="{StaticResource Text}" StrokeThickness="2.5" Width="18" Height="18"/>
                    </Button>
                    <TextBlock Text="{Binding MonthTitle}" FontFamily="{StaticResource Display}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding WeekdayHeaders}" Margin="6,0,6,6">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="12" HorizontalAlignment="Center"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding MonthRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{Binding Ring}" BorderThickness="2" CornerRadius="12" Margin="0,0,0,6" Padding="2">
                                <Button Command="{Binding SelectCommand}" Style="{StaticResource BtnFlat}" HorizontalContentAlignment="Stretch" ToolTip="{Binding Label}">
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Bg}" BorderBrush="{Binding Border}" BorderThickness="{Binding Ring}" CornerRadius="8"
                                                        Margin="3" Padding="10,0" Opacity="{Binding Opacity}" Height="46">
                                                    <DockPanel VerticalAlignment="Center">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{Binding Fg}" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Num}" FontFamily="{StaticResource BodyXB}" FontSize="15" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="5" Margin="0,10,0,0" Style="{StaticResource MutedText}" FontSize="12"
                   Text="Un jour passé non validé apparaît en « Manqué » ; tu peux le valider s'il a été fait sans être enregistré. Quantités pour 1 personnage."/>
    </Grid>
</UserControl>
