<UserControl x:Class="DofusTeamOrganizer.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DofusTeamOrganizer.Views">
    <UserControl.Resources>
        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
            <!-- Titre -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Accueil" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Gestion multicompte" Style="{StaticResource PageSub}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}"
                        BorderThickness="1" CornerRadius="20" Padding="16,9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Good}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectedText}" FontFamily="{StaticResource BodyXB}" FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Rappel Almanax -->
            <Button HorizontalAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="almanax" Margin="0,0,0,16" MinHeight="44" Padding="14,6"
                    Background="#1FF2963C" BorderBrush="{DynamicResource Warn}" BorderThickness="1" Foreground="{DynamicResource WarnText}"
                    Visibility="{Binding Almanax.NeedsReminder, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBell}" Stroke="{DynamicResource WarnText}" Width="15" Height="15" Margin="0,0,8,0"/>
                    <TextBlock Text="Almanax du jour"/>
                    <Border Background="{DynamicResource KeyBg}" CornerRadius="6" Padding="10,3" Margin="16,0,0,0"
                            Visibility="{Binding Almanax.IsSunday, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Almanax · Préparer la semaine" Foreground="{DynamicResource Text}"/>
                    </Border>
                </StackPanel>
            </Button>

            <!-- Personnages -->
            <ItemsControl ItemsSource="{Binding Characters}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Panel}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,12,12"
                                BorderBrush="{Binding Detected, Converter={StaticResource Status}, ConverterParameter=border}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{Binding Color, Converter={StaticResource HexBrush}}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Display}" FontSize="19" Foreground="#12151A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyXB}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ClassName}" Foreground="{DynamicResource Muted}" FontSize="12.5"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource KeyBg}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0"
                                            Visibility="{Binding IsMain, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="Principal" FontSize="11" FontFamily="{StaticResource BodyXB}"/>
                                    </Border>
                                </Grid>
                                <Border HorizontalAlignment="Left" Height="32" CornerRadius="16" Padding="12,0"
                                        Background="{Binding Detected, Converter={StaticResource Status}, ConverterParameter=bg}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Fill="{Binding Detected, Converter={StaticResource Status}, ConverterParameter=dot}"/>
                                        <TextBlock Text="{Binding Detected, Converter={StaticResource Status}}" FontFamily="{StaticResource BodyXB}"
                                                   Foreground="{Binding Detected, Converter={StaticResource Status}, ConverterParameter=text}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Raccourcis -->
                <Border Style="{StaticResource Card}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" CornerRadius="12" Margin="0,0,12,0" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Raccourcis" Style="{StaticResource H2}" FontSize="14" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10"><TextBlock Text="{Binding MainCharLabel}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right"><TextBlock Text="F1" FontFamily="{StaticResource BodyXB}" FontSize="12"/></Border></Grid>
                        <Grid Margin="0,0,0,10"><TextBlock Text="Personnage précédent" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right"><TextBlock Text="F6" FontFamily="{StaticResource BodyXB}" FontSize="12"/></Border></Grid>
                        <Grid Margin="0,0,0,10"><TextBlock Text="Copier les invitations" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right"><TextBlock Text="F12" FontFamily="{StaticResource BodyXB}" FontSize="12"/></Border></Grid>
                        <Grid Margin="0,0,0,10"><TextBlock Text="Afficher / masquer" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right"><TextBlock Text="Ctrl+Alt+O" FontFamily="{StaticResource BodyXB}" FontSize="12"/></Border></Grid>
                        <!-- Touche * : interrupteur -->
                        <ToggleButton x:Name="StarToggle" IsChecked="{Binding SwapEnabled, Mode=TwoWay}" Height="44" Cursor="Hand" Margin="0,0,0,10"
                                      ToolTip="Touche étoile : passer au personnage suivant">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1.5" CornerRadius="8" Padding="12,0">
                                        <DockPanel VerticalAlignment="Center">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock x:Name="lbl" Text="OFF" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" MinWidth="26" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border x:Name="track" Width="42" Height="24" CornerRadius="12" Background="{DynamicResource Track}">
                                                    <Ellipse x:Name="knob" Width="18" Height="18" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                                </Border>
                                            </StackPanel>
                                            <Border Background="{DynamicResource KeyBg}" CornerRadius="5" Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="*" FontFamily="{StaticResource BodyXB}" FontSize="12" Foreground="{DynamicResource Text}"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="lbl" Property="Text" Value="ON"/>
                                            <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentText}"/>
                                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock Text="La touche * ne réagit que lorsque DOFUS est la fenêtre active. L'interrupteur l'active ou la désactive."
                                   Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Invitations & Zaaps -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" CornerRadius="12" Margin="0" VerticalAlignment="Stretch">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Big}" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}"
                                    BorderThickness="0" Command="{Binding CopyInvitesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Copier les invitations"/>
                                    <Border Background="{DynamicResource AccentText}" CornerRadius="5" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="F12" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Invitations &amp; Zaaps" Style="{StaticResource H2}" FontSize="14" VerticalAlignment="Center"/>
                        </DockPanel>
                        <v:ZaapPicker Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Favorites}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8" Height="40" Padding="12,0" ToolTip="{Binding Command}"
                                            Command="{Binding DataContext.CopyZaapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="20" Padding="12,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoStar}" Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}" StrokeThickness="0" Width="12" Height="12" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding ShortName}" Foreground="{DynamicResource Text}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <UniformGrid Columns="2">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="almanax" Style="{StaticResource Big}" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCalendar}" Stroke="{DynamicResource Text}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Almanax"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowMiniCommand}" Style="{StaticResource Big}" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoExpand}" Stroke="{DynamicResource Text}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Passer en mode Mini"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
