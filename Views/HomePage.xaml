<UserControl x:Class="DofusTeamOrganizer.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DofusTeamOrganizer.Views">
    <UserControl.Resources>
        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
    <Grid MinHeight="{Binding ActualHeight, ElementName=Scroller}" Margin="0,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*" MinHeight="190"/>
        </Grid.RowDefinitions>

            <!-- Titre, boutons Almanax et Mini, pastille des connectés -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Accueil" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Gestion multicompte" Style="{StaticResource PageSub}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Command="{Binding NavigateCommand}" CommandParameter="almanax" Style="{StaticResource Big}" Margin="0,0,10,0"
                            Background="{DynamicResource Hot}" Foreground="{DynamicResource HotText}" BorderThickness="0" FontFamily="{StaticResource BodyXB}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCalendar}" Stroke="{DynamicResource HotText}" Margin="0,0,8,0"/>
                            <TextBlock Text="Almanax"/>
                        </StackPanel>
                    </Button>
                    <Border Height="44" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="22" Padding="18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource Good}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectedText}" FontFamily="{StaticResource BodyXB}" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <WrapPanel Grid.Row="1">
            <!-- Rappel Almanax : offrande du jour et bouton Fait -->
            <Border Margin="0,0,10,10" Padding="14,6" CornerRadius="8" MinHeight="44"
                    Background="#1FF2963C" BorderBrush="{DynamicResource Warn}" BorderThickness="1"
                    Visibility="{Binding Almanax.NeedsReminder, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBell}" Stroke="{DynamicResource WarnText}" Width="15" Height="15" Margin="0,0,8,0"/>
                    <TextBlock Text="Almanax du jour :" Foreground="{DynamicResource WarnText}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Almanax.TodaySummary}" FontFamily="{StaticResource BodyXB}" Foreground="{DynamicResource Text}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource KeyBg}" CornerRadius="6" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Almanax.IsSunday, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Almanax · Préparer la semaine" Foreground="{DynamicResource Text}"/>
                    </Border>
                    <Button Content="Ouvrir" Command="{Binding NavigateCommand}" CommandParameter="almanax" Margin="16,0,0,0" MinHeight="32" Padding="14,0"/>
                    <Button Content="Fait" Command="{Binding Almanax.TodayDoneCommand}" Margin="8,0,0,0" MinHeight="32" Padding="16,0"
                            Background="{DynamicResource Hot}" Foreground="{DynamicResource HotText}" BorderThickness="0" FontFamily="{StaticResource BodyXB}"/>
                </StackPanel>
            </Border>
            <!-- Mise à jour disponible : bouton rouge vers les Paramètres -->
            <Button Command="{Binding NavigateCommand}" CommandParameter="settings" MinHeight="44" Padding="14,6" Margin="0,0,10,10"
                    Background="#26FF6B5F" BorderBrush="{DynamicResource Bad}" BorderThickness="1" Foreground="{DynamicResource BadText}" Cursor="Hand"
                    ToolTip="Ouvrir les Paramètres pour installer la mise à jour"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoBell}" Stroke="{DynamicResource BadText}" Width="15" Height="15" Margin="0,0,8,0"/>
                    <TextBlock Text="Mise à jour disponible" FontFamily="{StaticResource BodyXB}"/>
                    <TextBlock Text="{Binding UpdateVersionText}" Foreground="{DynamicResource Text}" Margin="10,0,0,0"/>
                    <TextBlock Text="Ouvrir les Paramètres  →" Margin="14,0,0,0"/>
                </StackPanel>
            </Button>
            </WrapPanel>

            <!-- Personnages -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Characters}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Active}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,12,10"
                                BorderBrush="{Binding Detected, Converter={StaticResource Status}, ConverterParameter=border}">
                            <StackPanel>
                                <!-- En-tête : avatar, nom, classe et statut -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{Binding Color, Converter={StaticResource HexBrush}}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Display}" FontSize="21" Foreground="#12151A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyXB}" FontSize="19" Margin="0,0,8,0"/>
                                            <Border Background="{DynamicResource KeyBg}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center"
                                                    Visibility="{Binding IsMain, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="Principal" FontSize="11.5" FontFamily="{StaticResource BodyXB}"/>
                                            </Border>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,3,0,0">
                                            <TextBlock Text="{Binding ClassName}" Foreground="{DynamicResource Muted}" FontSize="13.5" Margin="0,0,10,0"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{Binding Detected, Converter={StaticResource Status}, ConverterParameter=dot}"/>
                                                <TextBlock Text="{Binding Detected, Converter={StaticResource Status}}" FontFamily="{StaticResource BodyXB}" FontSize="13"
                                                           Foreground="{Binding Detected, Converter={StaticResource Status}, ConverterParameter=text}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Niveau et alignement -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="7*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="10" Padding="10,5" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Niveau" Foreground="{DynamicResource Muted}" FontSize="11" FontFamily="{StaticResource BodyXB}"/>
                                            <TextBlock Text="{Binding LevelValue}" FontSize="19" FontFamily="{StaticResource BodyXB}" ToolTip="{Binding LevelText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOmega}" Value="True">
                                                                <Setter Property="Foreground" Value="#F2B544"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="10" Padding="10,5" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Alignement" Foreground="{DynamicResource Muted}" FontSize="11" FontFamily="{StaticResource BodyXB}"/>
                                            <TextBlock Text="{Binding Faction}" FontSize="15" FontFamily="{StaticResource BodyXB}"
                                                       Foreground="{Binding FactionColor, Converter={StaticResource HexBrush}}"/>
                                            <TextBlock Text="{Binding OrderText}" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Métiers : pastilles à la largeur de leur texte, la carte grandit avec leur nombre -->
                                <ItemsControl ItemsSource="{Binding JobChips}" Margin="0,6,0,0"
                                              Visibility="{Binding HasJobs, Converter={StaticResource BoolVis}}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="0,0,4,4">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Level}" FontFamily="{StaticResource BodyXB}" FontSize="11.5" Margin="5,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Max}" Value="True">
                                                                        <Setter Property="Foreground" Value="#F2B544"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontFamily="{StaticResource BodyXB}"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" MinWidth="300"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <!-- Raccourcis -->
                <Border Style="{StaticResource Card}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" CornerRadius="12" Margin="0,0,12,0" VerticalAlignment="Stretch">
                    <StackPanel TextElement.FontSize="14">
                        <TextBlock Text="Raccourcis" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2">
                        <Grid Margin="0,0,16,10"><TextBlock Text="{Binding MainCharLabel}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right"><TextBlock Text="F1" FontFamily="{StaticResource BodyXB}" FontSize="12"/></Border></Grid>
                        <Grid Margin="0,0,16,10"><TextBlock Text="Personnage précédent" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right"><TextBlock Text="F6" FontFamily="{StaticResource BodyXB}" FontSize="12"/></Border></Grid>
                        <Grid Margin="0,0,16,10"><TextBlock Text="Copier les invitations" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right"><TextBlock Text="F12" FontFamily="{StaticResource BodyXB}" FontSize="12"/></Border></Grid>
                        <Grid Margin="0,0,16,10"><TextBlock Text="Afficher / masquer" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right"><TextBlock Text="Ctrl+Alt+O" FontFamily="{StaticResource BodyXB}" FontSize="12"/></Border></Grid>
                        </UniformGrid>
                        <!-- Touche * : interrupteur -->
                        <ToggleButton x:Name="StarToggle" IsChecked="{Binding SwapEnabled, Mode=TwoWay}" Height="40" Cursor="Hand" Margin="0,0,0,8"
                                      ToolTip="Touche étoile : passer au personnage suivant">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1.5" CornerRadius="8" Padding="12,0">
                                        <DockPanel VerticalAlignment="Center">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock x:Name="lbl" Text="OFF" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" MinWidth="26" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border x:Name="track" Width="42" Height="24" CornerRadius="12" Background="{DynamicResource Track}">
                                                    <Ellipse x:Name="knob" Width="18" Height="18" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                                </Border>
                                            </StackPanel>
                                            <Border Background="{DynamicResource KeyBg}" CornerRadius="5" Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="*" FontFamily="{StaticResource BodyXB}" FontSize="12" Foreground="{DynamicResource Text}"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="lbl" Property="Text" Value="ON"/>
                                            <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentText}"/>
                                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock Text="La touche * ne réagit que lorsque DOFUS est la fenêtre active. L'interrupteur l'active ou la désactive."
                                   Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Invitations & Zaaps -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" CornerRadius="12" Margin="0" VerticalAlignment="Stretch">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Big}" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}"
                                    BorderThickness="0" Command="{Binding CopyInvitesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Copier les invitations"/>
                                    <Border Background="{DynamicResource AccentText}" CornerRadius="5" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="F12" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Invitations &amp; Zaaps" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center"/>
                        </DockPanel>
                        <v:ZaapPicker Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Favorites}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8" Height="38" Padding="12,0" FontSize="14" ToolTip="{Binding Command}"
                                            Command="{Binding DataContext.CopyZaapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="22" Padding="16,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoStar}" Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}" StrokeThickness="0" Width="12" Height="12" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding ShortName}" Foreground="{DynamicResource Text}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
