<UserControl x:Class="DofusTeamOrganizer.Views.ForgePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Forgemagie" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Saisis les lignes de ton objet : la page donne la chance de chaque rune (calcul reconstitué, aucune lecture du jeu)" Style="{StaticResource PageSub}"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="0,0,18,8">
                <TextBlock Text="Niveau de l'objet" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,0,0,4"/>
                <TextBox Text="{Binding LevelText, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalContentAlignment="Center" ToolTip="Sous le niveau 170, les chances sont un peu meilleures"/>
            </StackPanel>
            <StackPanel Margin="0,0,18,8">
                <TextBlock Text="Pourcentage affiché" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,0,0,4"/>
                <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource Chip}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,-8">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
            <Button Content="Ajouter une ligne" Command="{Binding AddLineCommand}" Style="{StaticResource BtnPrimary}" Margin="0,18,10,8" Padding="16,0" MinHeight="40"/>
            <Button Content="Tout effacer" Command="{Binding ClearCommand}" Margin="0,18,14,8" Padding="16,0" MinHeight="40"
                    ToolTip="Retire toutes les lignes"/>
            <TextBlock Text="{Binding QualityText}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" Height="40" VerticalAlignment="Bottom" Margin="0,0,0,8"
                       ToolTip="Poids total de l'objet divisé par son poids total aux jets maximum"/>
        </WrapPanel>

        <Border Grid.Row="2" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="14,10,14,6">
                    <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Caractéristique" Foreground="{DynamicResource Dim}" FontSize="12" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" Text="Valeur" Foreground="{DynamicResource Dim}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Min" Foreground="{DynamicResource Dim}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Max" Foreground="{DynamicResource Dim}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Poids/pt" Foreground="{DynamicResource Dim}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="Rune" Foreground="{DynamicResource Dim}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="Pa" Foreground="{DynamicResource Dim}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="Ra" Foreground="{DynamicResource Dim}" FontSize="12" HorizontalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="Aucune ligne. Clique sur « Ajouter une ligne », puis choisis la caractéristique et saisis sa valeur et ses jets min et max (ceux de l'objet)." Foreground="{DynamicResource Dim}" Margin="16,10" TextWrapping="Wrap"
                           Visibility="{Binding HasNoLine, Converter={StaticResource BoolVis}}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Field}" BorderThickness="0,1,0,0" MinHeight="60" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" DisplayMemberPath="Name"
                                                  ItemsSource="{Binding DataContext.Presets, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Preset, Mode=TwoWay}"/>
                                        <TextBox Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Column="2" Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Column="3" Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <TextBox Grid.Column="4" Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                                 ToolTip="Poids d'un point de cette caractéristique"/>
                                        <Border Grid.Column="5" Margin="0,0,8,0" Padding="6,4" CornerRadius="8" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Visibility="{Binding Rune1.Visible, Converter={StaticResource BoolVis}}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Rune1.Label}" Foreground="{DynamicResource Dim}" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Rune1.Text}" FontFamily="{StaticResource BodyXB}" FontSize="14" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rune1.Tone}" Value="good"><Setter Property="Foreground" Value="{DynamicResource Good}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Rune1.Tone}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Rune1.Tone}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="6" Margin="0,0,8,0" Padding="6,4" CornerRadius="8" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Visibility="{Binding Rune2.Visible, Converter={StaticResource BoolVis}}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Rune2.Label}" Foreground="{DynamicResource Dim}" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Rune2.Text}" FontFamily="{StaticResource BodyXB}" FontSize="14" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rune2.Tone}" Value="good"><Setter Property="Foreground" Value="{DynamicResource Good}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Rune2.Tone}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Rune2.Tone}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="7" Margin="0,0,8,0" Padding="6,4" CornerRadius="8" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Visibility="{Binding Rune3.Visible, Converter={StaticResource BoolVis}}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Rune3.Label}" Foreground="{DynamicResource Dim}" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Rune3.Text}" FontFamily="{StaticResource BodyXB}" FontSize="14" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rune3.Tone}" Value="good"><Setter Property="Foreground" Value="{DynamicResource Good}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Rune3.Tone}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Rune3.Tone}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Button Grid.Column="8" Content="✕" Command="{Binding RemoveCommand}" ToolTip="Retirer la ligne" Width="30" Height="30" Padding="0" MinHeight="0"
                                                Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                   Text="★ = la rune qui donne le plus de succès critiques sur la ligne. Calcul reconstitué : un écart de quelques points avec le simulateur de DoFocus est possible."/>
    </Grid>
</UserControl>
