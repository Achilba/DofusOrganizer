<UserControl x:Class="DofusTeamOrganizer.Views.DungeonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{DynamicResource Field}" BorderThickness="0,0,0,1" MinHeight="44" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="box" Width="22" Height="22" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Off}" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path x:Name="tick" Data="{StaticResource IcoCheck}" Stroke="#0E1014" StrokeThickness="2.6" Stretch="Uniform" Width="12" Height="9"
                                          Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" Background="{DynamicResource KeyBg}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock FontSize="12" FontFamily="{StaticResource BodyXB}">
                                        <Run Text="Niv. "/><Run Text="{Binding LevelText, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding Pos}" Foreground="{DynamicResource Muted}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A3DD68C"/>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Good}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Good}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Cell" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="box" Width="26" Height="26" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Off}" Background="Transparent">
                            <Path x:Name="tick" Data="{StaticResource IcoCheck}" Stroke="#0E1014" StrokeThickness="2.6" Stretch="Uniform" Width="12" Height="9"
                                  Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Good}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Good}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InfoBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="11" Background="{DynamicResource KeyBg}" BorderBrush="{DynamicResource Line2}" BorderThickness="1">
                            <TextBlock Text="i" Foreground="{TemplateBinding Foreground}" FontSize="12" FontFamily="{StaticResource BodyXB}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Donjons" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Succès de donjon par boss et par personnage · recherche, tri et filtre par niveau" Style="{StaticResource PageSub}"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBox Width="230" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom, niveau ou coordonnées" Margin="0,0,10,8"/>
            <ComboBox Width="200" ItemsSource="{Binding SortChoices}" ItemStringFormat="Tri : {0}" SelectedItem="{Binding Sort, Mode=TwoWay}" Margin="0,0,10,8"/>
            <ComboBox Width="170" ItemsSource="{Binding LevelFilterChoices}" ItemStringFormat="Niveau : {0}" SelectedItem="{Binding LevelFilter, Mode=TwoWay}" Margin="0,0,10,8"/>
            <ComboBox Width="170" ItemsSource="{Binding CharNames}" SelectedItem="{Binding AchChar, Mode=TwoWay}" ItemStringFormat="Perso : {0}" Margin="0,0,10,8"
                      Visibility="{Binding AchMode, Converter={StaticResource BoolVis}}"/>
            <ToggleButton IsChecked="{Binding OnlyMissing, Mode=TwoWay}" Height="40" Cursor="Hand" Margin="0,0,10,8" Visibility="{Binding AchMode, Converter={StaticResource BoolVis}}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1.5" CornerRadius="8" Padding="12,0">
                            <TextBlock x:Name="t" Text="Manquants seulement : NON" Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyXB}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="t" Property="Text" Value="Manquants seulement : OUI"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <TextBlock Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" Height="40" Margin="0,0,0,8" VerticalAlignment="Center" Visibility="{Binding AchMode, Converter={StaticResource BoolVis}}">
                <Run Text="{Binding AchCounter, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AchShown, Mode=OneWay}"/>
            </TextBlock>
        </WrapPanel>
        <Border Grid.Row="2" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True"
                Visibility="{Binding AchMode, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="14,8,26,8" TextBlock.Foreground="{DynamicResource Muted}" TextBlock.FontFamily="{StaticResource BodyXB}" TextBlock.FontSize="12">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="84"/>

                    <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Boss"/>
                    <TextBlock Grid.Column="1" Text="Niveau" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Chall 1" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Chall 2" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Duo / Trio" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="Spécial" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="Manque" HorizontalAlignment="Center"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
                    <ItemsControl ItemsSource="{Binding AchView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Field}" BorderThickness="0,1,0,0" Padding="14,6" MinHeight="58">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>

                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <DockPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource InfoBtn}" Margin="6,0,0,0" Command="{Binding OpenCommand}"
                                                    ToolTip="Ouvrir la page du donjon sur Dofusyelle"/>
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Bracket}" FontSize="13" FontFamily="{StaticResource BodyXB}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding H1, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding T1}" Width="80" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" Margin="0,0,0,4"/>
                                            <ToggleButton Style="{StaticResource Cell}" IsChecked="{Binding C1, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding H2, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding T2}" Width="80" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" Margin="0,0,0,4"/>
                                            <ToggleButton Style="{StaticResource Cell}" IsChecked="{Binding C2, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HG, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding TG}" Width="80" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" Margin="0,0,0,4"/>
                                            <ToggleButton Style="{StaticResource Cell}" IsChecked="{Binding G, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HS, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding TS}" Width="80" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" Margin="0,0,0,4"/>
                                            <Grid>
                                                <ToggleButton Style="{StaticResource Cell}" IsChecked="{Binding S, Mode=TwoWay}"/>
                                                <Button Style="{StaticResource InfoBtn}" HorizontalAlignment="Right" Margin="0,0,3,0" Width="20" Height="20" Cursor="Help"
                                                        ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="30000">
                                                    <Button.ToolTip>
                                                        <TextBlock Text="{Binding SpecialTip}" MaxWidth="320" TextWrapping="Wrap"/>
                                                    </Button.ToolTip>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Grid.Column="6" Text="{Binding Others, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap"
                   Text="Succès relevés sur DofusDB (144 boss : challenges, Duo/Trio/Quatuor, Spécial). Les cases sont propres à chaque personnage : choisis-le en haut."
                   Visibility="{Binding AchMode, Converter={StaticResource BoolVis}}"/>
    </Grid>
</UserControl>
