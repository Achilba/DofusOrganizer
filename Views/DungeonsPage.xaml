<UserControl x:Class="DofusTeamOrganizer.Views.DungeonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Field}" BorderThickness="0,0,0,1" MinHeight="44" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="box" Width="22" Height="22" CornerRadius="6" BorderThickness="2" BorderBrush="#6B7383" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path x:Name="tick" Data="{StaticResource IcoCheck}" Stroke="#0E1014" StrokeThickness="2.6" Stretch="Uniform" Width="12" Height="9"
                                          Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" Background="{StaticResource KeyBg}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock FontSize="12" FontFamily="{StaticResource BodyXB}">
                                        <Run Text="Niv. "/><Run Text="{Binding LevelText, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding Pos}" Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A3DD68C"/>
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Good}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Good}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Donjons" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Liste de contrôle · recherche et tri par niveau" Style="{StaticResource PageSub}"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,14" LastChildFill="False">
            <TextBox DockPanel.Dock="Left" Width="300" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom, niveau ou coordonnées" Margin="0,0,10,0"/>
            <ComboBox DockPanel.Dock="Left" Width="210" ItemsSource="{Binding SortChoices}" ItemStringFormat="Tri : {0}" SelectedItem="{Binding Sort, Mode=TwoWay}" Margin="0,0,10,0"/>
            <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding HideDone, Mode=TwoWay}" Height="40" Cursor="Hand">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1.5" CornerRadius="8" Padding="12,0">
                            <TextBlock x:Name="t" Text="Masquer les terminés : NON" Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyXB}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="t" Property="Text" Value="Masquer les terminés : OUI"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontFamily="{StaticResource BodyXB}" VerticalAlignment="Center">
                <Run Text="{Binding Counter, Mode=OneWay}"/><Run Text=" terminés · "/><Run Text="{Binding Shown, Mode=OneWay}"/>
            </TextBlock>
        </DockPanel>
        <Border Grid.Row="2" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding View}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource Row}" IsChecked="{Binding Done, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap"
                   Text="Liste relevée sur dofuspourlesnoobs.com (140 donjons, anomalies exclues), à recouper avec le jeu."/>
    </Grid>
</UserControl>
