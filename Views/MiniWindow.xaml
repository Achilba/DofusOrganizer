<Window x:Class="DofusTeamOrganizer.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DofusTeamOrganizer.Views"
        Title="DOFUS Team Organizer (mini)" Height="44" Width="980" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Foreground="{DynamicResource Text}" FontFamily="{StaticResource Body}" WindowStartupLocation="Manual"
        Opacity="{Binding MiniOpacity}">
    <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Height="44" Margin="0"
            MouseLeftButtonDown="Drag_MouseLeftButtonDown">
        <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- poignée -->
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoGrip}" Stroke="#6B7280" StrokeThickness="3" Width="8" Height="14" Margin="4,0,8,0" ToolTip="Glisser pour déplacer"/>

                        <!-- Compacte / complète -->
            <Button Grid.Column="1" Command="{Binding ToggleCompactCommand}" Width="32" Height="32" MinHeight="0" Padding="0" Margin="0,0,8,0" ToolTip="Barre compacte / complète">
                <Grid>
                <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource Text}" Stroke="{DynamicResource Text}" StrokeThickness="2" StrokeLineJoin="Round">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="M16 4L6 12L16 20Z"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MiniCompact}" Value="True">
                                    <Setter Property="Data" Value="M8 4L18 12L8 20Z"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Warn}" Stroke="{DynamicResource Side}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-13,-13,0"
                             ToolTip="Mise à jour disponible (Paramètres)">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding UpdateAvailable}" Value="True"/>
                                            <Condition Binding="{Binding MiniFull}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </Button>

            <!-- Touche * -->
            <ToggleButton Grid.Column="2" IsChecked="{Binding SwapEnabled, Mode=TwoWay}" Height="32" Cursor="Hand" Margin="0,0,8,0"
                          Visibility="{Binding MiniShowSwap, Converter={StaticResource BoolVis}}"
                          ToolTip="Touche étoile : passer au personnage suivant">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="8" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="lbl" Text="OFF" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="12.5" MinWidth="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border x:Name="track" Width="32" Height="18" CornerRadius="9" Background="{DynamicResource Track}">
                                    <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="lbl" Property="Text" Value="ON"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentText}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <Border Grid.Column="3" Width="1" Height="20" Background="{DynamicResource Line}" Margin="0,0,8,0"/>

            <!-- Invitations -->
            <Button Grid.Column="4" Command="{Binding CopyInvitesCommand}" Height="32" MinHeight="0" Padding="12,0" Margin="0" FontSize="13"
                    Visibility="{Binding MiniShowInvites, Converter={StaticResource BoolVis}}"
                    Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Invitations"/>
                </StackPanel>
            </Button>

            <!-- Zaap -->
            <v:ZaapPicker Grid.Column="5" VerticalAlignment="Center" Margin="8,0,8,0" BoxHeight="32"
                          Visibility="{Binding ShowMiniZaap, Converter={StaticResource BoolVis}}"/>

            <!-- Copié -->
            <Border Grid.Column="6" Height="32" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8"
                    Padding="10,0" Margin="0,0,8,0" Visibility="{Binding Toast, Converter={StaticResource NotEmptyVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCheck}" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="COPIÉ" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="7" Width="1" Height="20" Background="{DynamicResource Line}" Margin="0,0,8,0"
                    Visibility="{Binding ShowMiniSeparator, Converter={StaticResource BoolVis}}"/>

            <!-- Almanax -->
            <Button Grid.Column="8" Command="{Binding OpenAlmanaxFromMiniCommand}" Height="32" MinHeight="0" Padding="12,0" Margin="0,0,8,0" FontSize="13" ToolTip="Almanax du jour à valider"
                    Visibility="{Binding ShowMiniAlmanax, Converter={StaticResource BoolVis}}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCalendar}" Stroke="{DynamicResource Text}" Width="14" Height="14" Margin="0,0,7,0"/>
                        <TextBlock Text="Almanax"/>
                    </StackPanel>
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Warn}" Stroke="{DynamicResource Side}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-11,-18,0"
                             Visibility="{Binding Almanax.NeedsReminder, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Button>

            <!-- Retour à la fenêtre complète -->
            <Button Grid.Column="9" Command="{Binding ShowMainCommand}" Width="32" Height="32" MinHeight="0" Padding="0" Margin="0" BorderBrush="{DynamicResource Text}"
                    ToolTip="Revenir à l'interface complète" Visibility="{Binding MiniFull, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCompress}" Stroke="{DynamicResource Text}" Width="14" Height="14"/>
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Warn}" Stroke="{DynamicResource Side}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-13,-13,0"
                             ToolTip="Mise à jour disponible (Paramètres)"
                             Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Button>

        </Grid>
    </Border>
</Window>
