<UserControl x:Class="DofusTeamOrganizer.Views.SettingsPage"
             PreviewKeyDown="Page_PreviewKeyDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
        <!-- Interrupteur de la colonne « Raccourcis » : couleur « vedette » du thème -->
        <Style x:Key="HotSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="{DynamicResource Track}">
                            <Ellipse x:Name="knob" Width="18" Height="18" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Hot}"/>
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource HotText}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Sauvegardes, barre Mini, raccourcis, personnages" Style="{StaticResource PageSub}"/>
            </StackPanel>

            <!-- Sauvegardes -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Sauvegardes" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Sauvegarde automatique chaque jour · les 7 dernières copies sont conservées" IsChecked="{Binding AutoBackup}" Margin="0,0,0,12"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12">
                        <Run Text="Dernière sauvegarde : "/><Run Text="{Binding LastBackup, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCheck}" Stroke="{DynamicResource GoodText}" StrokeThickness="2.5" Width="14" Height="14" Margin="0,0,8,0"
                              Visibility="{Binding DataIntact, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding DataIntactText}" Foreground="{DynamicResource GoodText}" TextWrapping="Wrap"
                                   Visibility="{Binding DataIntact, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding DataIntactText}" Foreground="{DynamicResource WarnText}" TextWrapping="Wrap"
                                   Visibility="{Binding DataIntact, Converter={StaticResource InvBoolVis}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Exporter mes données" Command="{Binding ExportCommand}" Style="{StaticResource Big}" Background="{DynamicResource Accent}"
                                Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}" Margin="0,0,8,0"/>
                        <Button Content="Importer une sauvegarde" Command="{Binding ImportCommand}" Style="{StaticResource Big}" Margin="0,0,8,0"/>
                        <Button Content="Copier ailleurs" Command="{Binding CopyBackupCommand}" Style="{StaticResource Big}" Margin="0,0,8,0" ToolTip="Copie tes données dans un autre dossier (autre disque, clé USB, cloud)"/>
                        <Button Content="Ouvrir le dossier" Command="{Binding OpenFolderCommand}" Style="{StaticResource Big}"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" Content="Copier automatiquement chaque jour dans le dossier choisi · les 14 dernières copies sont gardées" IsChecked="{Binding AutoExternalCopy}" Margin="0,14,0,6"/>
                    <TextBlock Text="{Binding ExternalCopyText}" Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Réinitialisation -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Réinitialisation" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Text="Remet toute l'appli à zéro, comme une nouvelle installation : données, réglages, thème, raccourcis et positions des barres. Une copie de sécurité est gardée dans le dossier Backups."
                               Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <Button Content="Tout réinitialiser…" Command="{Binding ResetAllCommand}" Style="{StaticResource Big}" HorizontalAlignment="Left"
                            BorderBrush="{DynamicResource Warn}" Foreground="{DynamicResource Warn}"/>
                </StackPanel>
            </Border>

            <!-- Mode Mini -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mode Mini" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Opacité" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Slider Width="260" Minimum="0.3" Maximum="1" Value="{Binding MiniOpacity}" IsMoveToPointEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MiniOpacityText}" Foreground="{DynamicResource Accent}" MinWidth="44" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" Content="Retenir la position de la barre d'un lancement à l'autre" IsChecked="{Binding RememberMiniPosition}" Margin="0,0,0,12"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Toujours au premier plan : la barre Mini n'est jamais masquée par DOFUS" IsChecked="{Binding MiniAlwaysOnTop}" Margin="0,0,0,12"/>
                    <TextBlock Text="À vérifier sur ton PC avec DOFUS en mode fenêtré." Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,0,0,14"/>
                    <TextBlock Text="Éléments affichés dans la barre" FontFamily="{StaticResource BodyXB}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Touche étoile (passer au personnage suivant)" IsChecked="{Binding MiniShowSwap}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Bouton Invitations" IsChecked="{Binding MiniShowInvites}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Zaap (barre complète)" IsChecked="{Binding MiniShowZaap}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Almanax (barre complète)" IsChecked="{Binding MiniShowAlmanax}" Margin="0,0,0,4"/>
                </StackPanel>
            </Border>

            <!-- Mode discret -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mode discret" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Ne pas afficher les messages automatiques" IsChecked="{Binding QuietMode}" Margin="0,0,0,10"/>
                    <TextBlock Text="Coupe les messages « Mise à jour disponible » et « remise à zéro » des tâches. Les confirmations de tes propres actions (Copié, Données exportées…) restent affichées. La pastille de mise à jour reste visible." Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Démarrage -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Démarrage" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Lancer l'appli au démarrage de Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,0,10"/>
                    <TextBlock Text="Elle s'ouvre comme à ta dernière fermeture (fenêtre normale ou barre Mini)." Foreground="{DynamicResource Dim}" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Page d'accueil -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Page d'accueil" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Text="Choisis les cartes affichées sur l'accueil. Les personnages à afficher se règlent plus bas, dans « Personnages et fonctions »." Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Cartes des personnages" IsChecked="{Binding HomeShowChars}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Carte Raccourcis" IsChecked="{Binding HomeShowShortcuts}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Carte Invitations et Zaaps" IsChecked="{Binding HomeShowInvites}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Inverser la place de Raccourcis et d'Invitations et Zaaps" IsChecked="{Binding HomeSwapBottom}"/>
                </StackPanel>
            </Border>

            <!-- Apparence -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Apparence" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Text="Choisis les couleurs de l'appli, inspirées des univers de DOFUS. Le changement est immédiat." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding ThemeRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="136" Height="64" Margin="0,0,10,10" Padding="12,0" HorizontalContentAlignment="Left"
                                        Background="{Binding BackgroundBrush}"
                                        Command="{Binding DataContext.ThemeClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Key}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="BorderThickness" Value="2.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="14" Height="14" Fill="{Binding AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyXB}" Foreground="#F3F0E8"/>
                                        </StackPanel>
                                        <Border Height="8" CornerRadius="4" Background="{Binding SurfaceBrush}" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Couleur d'accent" FontFamily="{StaticResource BodyXB}" Margin="0,8,0,4"/>
                    <TextBlock Text="{Binding AccentText}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding AccentSwatches}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="34" Height="34" MinHeight="0" Padding="0" Margin="0,0,8,0" Background="{Binding}" BorderBrush="{DynamicResource Line2}"
                                            Command="{Binding DataContext.AccentPickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            ToolTip="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Couleur du thème" Command="{Binding AccentPickCommand}" CommandParameter="" Height="34" MinHeight="0" Padding="12,0"/>
                    </StackPanel>

                    <TextBlock Text="Taille du texte" FontFamily="{StaticResource BodyXB}" Margin="0,8,0,4"/>
                    <TextBlock Text="Agrandit ou réduit toute la fenêtre principale. Sur un petit écran, garde 100 % ou moins." Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding ScaleChoices}" SelectedItem="{Binding ScaleChoice, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource Chip}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                             HorizontalAlignment="Left">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Raccourcis -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Raccourcis" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Text="Clique sur une touche, puis appuie sur la nouvelle (Échap pour annuler). Seul « Afficher / masquer » est global ; les autres ne fonctionnent que si DOFUS est au premier plan."
                               Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Changement de personnage actif dans DOFUS" IsChecked="{Binding SwapEnabled}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding ShortcutRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" MinWidth="176" Height="36" MinHeight="0" Padding="12,0" Content="{Binding ButtonText}"
                                                Command="{Binding DataContext.ShortcutClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WarnText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding Message, Converter={StaticResource NotEmptyVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Rétablir les raccourcis par défaut" Command="{Binding ResetShortcutsCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Personnages et fonctions -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Personnages et fonctions" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Text="Choisis dans quelles fonctions chaque personnage apparaît : un clic sur le nom d'une fonction l'active ou la désactive pour tous. L'ordre se règle en glissant-déposant les lignes : « Personnage suivant » et l'accueil le suivent. L'interrupteur de droite décide si le personnage est visité par « Personnage suivant / précédent »."
                               Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <Grid Margin="12,0,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PERSONNAGE" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11.5" VerticalAlignment="Bottom" Margin="26,0,0,4"/>
                        <ItemsControl Grid.Column="1" Grid.ColumnSpan="5" ItemsSource="{Binding FeatureColumns}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding ToggleAllCommand}" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="2,2" ToolTip="Activer ou désactiver pour tous">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyXB}" FontSize="12.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="11.5" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Characters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,0,8" MinHeight="52"
                                        AllowDrop="True" DragOver="Row_DragOver" Drop="Row_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Panel}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AnyOff}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Bg}"/>
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                                        <DockPanel VerticalAlignment="Center">
                                            <Border DockPanel.Dock="Left" Background="Transparent" Cursor="SizeAll" Margin="0,0,8,0" Padding="2,6" ToolTip="Glisser pour changer l'ordre"
                                                    PreviewMouseLeftButtonDown="Grip_Down" PreviewMouseMove="Grip_Move">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoGrip}" Stroke="#6B7280" StrokeThickness="3" Width="10" Height="18"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Foreground="{DynamicResource Dim}" Width="20" VerticalAlignment="Center"/>
                                            <Image DockPanel.Dock="Left" Source="{Binding ClassName, Converter={StaticResource ClassIcon}}" Width="26" Height="26" Margin="0,0,10,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource BodyXB}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ClassName, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding ShowHome}" HorizontalAlignment="Center" Margin="0,0,-12,0" ToolTip="Accueil"/>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding AchTracked}" HorizontalAlignment="Center" Margin="0,0,-12,0" ToolTip="Succès DJ"/>
                                        <CheckBox Grid.Column="3" IsChecked="{Binding ShowTasks}" HorizontalAlignment="Center" Margin="0,0,-12,0" ToolTip="Tâches"/>
                                        <CheckBox Grid.Column="4" IsChecked="{Binding ShowDreams}" HorizontalAlignment="Center" Margin="0,0,-12,0" ToolTip="Songes"/>
                                        <CheckBox Grid.Column="5" IsChecked="{Binding ShowNotes}" HorizontalAlignment="Center" Margin="0,0,-12,0" ToolTip="Notes"/>
                                        <CheckBox Grid.Column="6" Style="{StaticResource HotSwitch}" IsChecked="{Binding InSwap}" HorizontalAlignment="Center" ToolTip="Raccourcis : inclus dans « Personnage suivant / précédent »"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Le dernier interrupteur (Raccourcis) décide si le personnage est visité par les raccourcis de changement de personnage." Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Diagnostic -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Diagnostic" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding MemoryText}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="Copier le journal d'erreurs" Command="{Binding CopyErrorLogCommand}" Margin="0,0,12,0"/>
                        <TextBlock Text="Le journal reste sur ton PC et ne contient aucune donnée de jeu." Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Mises à jour -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mises à jour" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12">
                        <Run Text="{Binding VersionText, Mode=OneWay}"/><Run Text=" (installée)"/>
                    </TextBlock>
                    <WrapPanel>
                        <Button Content="Rechercher une mise à jour" Command="{Binding CheckUpdateCommand}" Margin="0,0,10,0"/>
                        <Button Content="{Binding InstallUpdateLabel}" Command="{Binding InstallUpdateCommand}" Background="{DynamicResource Accent}"
                                Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding UpdateText}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Visibility="{Binding UpdateText, Converter={StaticResource NotEmptyVis}}"/>
                    <TextBlock Text="L'appli vérifie au lancement s'il existe une nouvelle version. Tes données ne sont jamais touchées." Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Listes de données -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Listes de données" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Text="Zaaps, donjons, modificateurs 2026, Dofus et légendes sont intégrés à l'appli." Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBlock Text="La vérification en ligne au lancement n'existe pas encore dans cette version." Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="Notes de version" Command="{Binding PatchNotesCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- À propos -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="À propos" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Text="DOFUS Team Organizer" FontFamily="{StaticResource BodyXB}"/>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" Margin="0,2,0,10"/>
                    <TextBlock Text="Dossier de données" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                    <TextBlock Text="{Binding DataFolderText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,12"/>
                    <WrapPanel>
                        <Button Content="Page des versions (GitHub)" Command="{Binding OpenRepoCommand}" Margin="0,0,10,8"/>
                        <Button Content="Notes de version" Command="{Binding PatchNotesCommand}" Margin="0,0,10,8"/>
                        <Button Content="Ouvrir le dossier de données" Command="{Binding OpenFolderCommand}" Margin="0,0,10,8"/>
                        <Button Content="Copier les infos pour le support" Command="{Binding CopySupportInfoCommand}" Margin="0,0,10,8"
                                ToolTip="Version, Windows, dossier et dernières lignes du journal d'erreurs : à me coller en cas de bug"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
