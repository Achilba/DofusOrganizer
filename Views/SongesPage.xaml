<UserControl x:Class="DofusTeamOrganizer.Views.SongesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="LegendRow">
            <Border BorderBrush="{DynamicResource Field}" BorderThickness="0,0,0,1" MinHeight="48" Padding="14,5">
                <DockPanel VerticalAlignment="Center">
                    <Border DockPanel.Dock="Right" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1.5" CornerRadius="10" Height="38" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal">
                            <RepeatButton Style="{StaticResource StepBtn}" Content="−" Tag="{Binding}" Click="Dec_Click" IsEnabled="{Binding CanDec}"/>
                            <TextBox Style="{StaticResource StepBox}" Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"/>
                            <RepeatButton Style="{StaticResource StepBtn}" Content="+" Tag="{Binding}" Click="Inc_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyXB}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête commun : titre et passage Strat / Drops -->
        <Grid Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Songes" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Strat : équipes, stuffs et explications par type de run · Drops : légendes" Style="{StaticResource PageSub}"/>
            </StackPanel>
            <ListBox HorizontalAlignment="Right" VerticalAlignment="Bottom" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource Chip}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
        </Grid>

        <!-- Vue Strat -->
        <Grid Grid.Row="1" DataContext="{Binding Strat}" Visibility="{Binding DataContext.IsStrat, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="+ Ajouter une rubrique" Command="{Binding AddRunCommand}" Margin="8,0,10,0" VerticalAlignment="Top"/>
                <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Name"
                         ItemContainerStyle="{StaticResource Chip}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelected, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="0,0,10,0" DataContext="{Binding Selected}">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Supprimer la rubrique" Margin="12,0,0,0"
                                    Command="{Binding DataContext.Strat.DeleteRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <TextBlock DockPanel.Dock="Left" Text="Nom" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="+ Ajouter un personnage"
                                        Command="{Binding DataContext.Strat.AddSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <TextBlock Text="Équipe et stuffs" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <WrapPanel Margin="0,0,0,8">
                                            <ComboBox Width="200" ItemsSource="{Binding DataContext.Strat.CharNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Char, Mode=TwoWay}" Margin="0,0,10,0"/>
                                            <ComboBox Width="300" ItemsSource="{Binding StuffChoices}" SelectedItem="{Binding Stuff, Mode=TwoWay}" Margin="0,0,10,0"/>
                                            <Button Content="Ouvrir le stuff" Margin="0,0,10,0" Visibility="{Binding HasUrl, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.Strat.OpenStuffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="Retirer"
                                                    Command="{Binding DataContext.Strat.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Choisis un personnage, puis l'un de ses stuffs (ajoutés dans la page Personnages)." Style="{StaticResource PageSub}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Stratégie" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="Aucune rubrique : ajoute-en une avec le bouton ci-dessus." Style="{StaticResource PageSub}" HorizontalAlignment="Center" Margin="0,40,0,0"
                       Visibility="{Binding NoSelection, Converter={StaticResource BoolVis}}"/>
        </Grid>

        <!-- Vue Drops -->
        <Grid Grid.Row="1" Visibility="{Binding IsDrops, Converter={StaticResource BoolVis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" HorizontalAlignment="Left" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="18" Padding="14,8" Margin="0,0,0,12">
            <TextBlock FontFamily="{StaticResource BodyXB}">
                <Run Text="Légendes droppées : "/><Run Text="{Binding Total, Mode=OneWay}" Foreground="{DynamicResource Accent}"/>
            </TextBlock>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Top}" ItemTemplate="{StaticResource LegendRow}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Légendes animales" FontFamily="{StaticResource BodyXB}" FontSize="15"/>
            <TextBlock Text="4 légendes · compteur de chacune" Foreground="{DynamicResource Muted}" FontSize="12"/>
        </StackPanel>
        <Border Grid.Row="4" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Animal}" ItemTemplate="{StaticResource LegendRow}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="Légendes classiques" FontFamily="{StaticResource BodyXB}" FontSize="15"/>
            <TextBlock Text="26 légendes · compteur de chacune · fais défiler la liste" Foreground="{DynamicResource Muted}" FontSize="12"/>
        </StackPanel>
        <Border Grid.Row="6" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Visible">
                <ItemsControl ItemsSource="{Binding Classic}" ItemTemplate="{StaticResource LegendRow}"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="7" Margin="0,10,0,0" Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap"
                   Text="Noms relevés sur krosmolab.fr (Ressources des Songes, niveau 200), à recouper avec le jeu."/>
        </Grid>
    </Grid>
</UserControl>
