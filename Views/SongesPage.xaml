<UserControl x:Class="DofusTeamOrganizer.Views.SongesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
        <DataTemplate x:Key="LegendRow">
            <Border BorderBrush="{DynamicResource Field}" BorderThickness="0,0,0,1" MinHeight="48" Padding="14,5">
                <DockPanel VerticalAlignment="Center">
                    <Border DockPanel.Dock="Right" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1.5" CornerRadius="10" Height="38" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal">
                            <RepeatButton Style="{StaticResource StepBtn}" Content="−" Tag="{Binding}" Click="Dec_Click" IsEnabled="{Binding CanDec}"/>
                            <TextBox Style="{StaticResource StepBox}" Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"/>
                            <RepeatButton Style="{StaticResource StepBtn}" Content="+" Tag="{Binding}" Click="Inc_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyXB}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête commun : titre et passage Strat / Drops -->
        <Grid Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Songes" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Strat : équipes, stuffs et explications par type de run · Drops : légendes" Style="{StaticResource PageSub}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,0">
                <!-- Barre Mini réservée aux songes (même couleur que le bouton « Mode Mini » du menu) -->
                <Button Command="{Binding MiniSongeCommand}" Height="40" Margin="0,0,10,8" Padding="14,0" Background="{DynamicResource Hot}" Foreground="{DynamicResource HotText}"
                        BorderThickness="0" FontFamily="{StaticResource BodyXB}" ToolTip="Ouvrir la barre Mini réservée aux songes">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoExpand}" Stroke="{DynamicResource HotText}" Width="16" Height="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Mode mini Songe"/>
                    </StackPanel>
                </Button>
                <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource Chip}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Grid>

        <!-- Vue Strat -->
        <Grid Grid.Row="1" DataContext="{Binding Strat}" Visibility="{Binding DataContext.IsStrat, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Runs : une puce par run, et « + Run » qui propose des modèles -->
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="+ Run  ▾" Command="{Binding ToggleTemplatesCommand}" Margin="8,0,10,8" VerticalAlignment="Top" Height="40"/>
                <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Name"
                         ItemContainerStyle="{StaticResource Chip}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,10,10" Visibility="{Binding TemplatesOpen, Converter={StaticResource BoolVis}}">
                <WrapPanel>
                    <TextBlock Text="Créer un run :" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Paradoxe 1 Salle" Command="{Binding AddRunCommand}" CommandParameter="salle" Margin="0,0,8,0"/>
                    <Button Content="Paradoxe 1 Boss" Command="{Binding AddRunCommand}" CommandParameter="boss" Margin="0,0,8,0"/>
                    <Button Content="Run vide" Command="{Binding AddRunCommand}" CommandParameter="vide" Margin="0,0,8,0"/>
                    <Button Content="Importer un run" Command="{Binding ImportRunCommand}"/>
                </WrapPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelected, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="0,0,10,0">
                    <!-- Nom et actions -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="Dupliquer" Command="{Binding DuplicateRunCommand}" Margin="0,0,6,0" ToolTip="Copie le run entier (équipe et texte) dans un nouveau run"/>
                                <Button Content="Copier la strat" Command="{Binding CopyRunCommand}" Margin="0,0,6,0" ToolTip="Copie l'équipe dans l'ordre INI et le texte"/>
                                <Button Content="Exporter" Command="{Binding ExportRunCommand}" Margin="0,0,6,0" ToolTip="Enregistre le run dans un fichier à partager"/>
                                <Button Content="{Binding ReadLabel}" Command="{Binding ToggleReadingCommand}" Margin="0,0,6,0"/>
                                <Button Content="Supprimer" Command="{Binding DeleteRunCommand}"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Nom" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                        </DockPanel>
                    </Border>

                    <!-- Compteur de runs -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,14">
                        <TextBlock Text="RUNS RÉALISÉS" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1.5" CornerRadius="10" Height="38" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" Command="{Binding DecCommand}" IsEnabled="{Binding Selected.CanDec}" Width="34" MinHeight="0" Height="38" Padding="0" BorderThickness="0" Background="Transparent"/>
                                <TextBlock Text="{Binding Selected.Count}" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource BodyXB}" FontSize="16" Foreground="{DynamicResource Accent}"/>
                                <Button Content="+" Command="{Binding IncCommand}" Width="34" MinHeight="0" Height="38" Padding="0" BorderThickness="0" Background="Transparent"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding RunMeta}" Foreground="{DynamicResource Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Mode édition -->
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="+ Ajouter un personnage" Command="{Binding AddSlotCommand}"
                                            Visibility="{Binding Selected.CanAddSlot, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="Équipe et stuffs" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Glisse une carte par sa poignée pour changer l'ordre (INI), ou change le numéro INI de la carte. Quatre personnages au maximum."
                                           Style="{StaticResource PageSub}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="14" Padding="12,12,2,2">
                                    <ItemsControl ItemsSource="{Binding Selected.Slots}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,0,10,10"
                                                        AllowDrop="True" DragOver="Slot_DragOver" Drop="Slot_Drop">
                                                    <DockPanel>
                                                        <!-- Poignée sur toute la hauteur de la carte -->
                                                        <Border DockPanel.Dock="Left" Width="26" Background="{DynamicResource Field}" CornerRadius="11,0,0,11" Cursor="SizeAll"
                                                                ToolTip="Glisser pour changer l'ordre" PreviewMouseLeftButtonDown="Grip_Down" PreviewMouseMove="Grip_Move">
                                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoGrip}" Stroke="#6B7280" StrokeThickness="3" Width="8" Height="14"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Grid Margin="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <DockPanel Margin="0,0,0,8">
                                                                <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" MinHeight="0" Padding="0" Margin="6,0,0,0" ToolTip="Retirer ce personnage"
                                                                        Command="{Binding DataContext.Strat.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Field}" Margin="0,0,10,0">
                                                                    <Image Source="{Binding ClassName, Converter={StaticResource ClassIcon}}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Border>
                                                                <ComboBox ItemsSource="{Binding DataContext.Strat.CharNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          SelectedItem="{Binding Char, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                                                <TextBlock Text="INI" Foreground="#7CC4FF" FontFamily="{StaticResource BodyXB}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <ComboBox ItemsSource="{Binding IniChoices}" SelectedItem="{Binding Ini, Mode=TwoWay}" Width="64"/>
                                                            </StackPanel>
                                                            <DockPanel Grid.Row="2">
                                                                <Button DockPanel.Dock="Right" Content="Ouvrir" Margin="6,0,0,0" ToolTip="Ouvrir le stuff"
                                                                        Visibility="{Binding HasUrl, Converter={StaticResource BoolVis}}"
                                                                        Command="{Binding DataContext.Strat.OpenStuffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                                <ComboBox ItemsSource="{Binding StuffChoices}" SelectedItem="{Binding Stuff, Mode=TwoWay}"/>
                                                            </DockPanel>
                                                        </Grid>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Text="Choisis un personnage, puis l'un de ses stuffs (ajoutés dans la page Personnages)." Style="{StaticResource PageSub}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Stratégie" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                <TextBlock Text="Une ligne qui commence par « - [ ] » devient une case à cocher dans « Étapes à cocher »." Style="{StaticResource PageSub}" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Selected.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Mode lecture -->
                    <StackPanel Visibility="{Binding Reading, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding Selected.Slots}" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="14" Background="{DynamicResource Field}" Margin="0,0,14,0">
                                                <Image Source="{Binding ClassName, Converter={StaticResource ClassIcon}}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Ini, StringFormat='INI {0}'}" Foreground="#7CC4FF" FontFamily="{StaticResource BodyXB}" FontSize="13"/>
                                                <TextBlock Text="{Binding Char}" FontFamily="{StaticResource BodyXB}" FontSize="19"/>
                                                <TextBlock Text="{Binding Stuff}" Foreground="{DynamicResource Muted}" FontSize="14"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasChecks, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Étapes à cocher" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Checks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" FontSize="16" Margin="0,0,0,8"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <TextBlock Text="{Binding ReadText}" TextWrapping="Wrap" FontSize="17" LineHeight="26"/>
                        </Border>
                    </StackPanel>

                    <!-- Étapes à cocher en mode édition -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding ShowEditChecks, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="Étapes à cocher" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="Aucun run : ajoute-en un avec « + Run »." Style="{StaticResource PageSub}" HorizontalAlignment="Center" Margin="0,40,0,0"
                       Visibility="{Binding NoSelection, Converter={StaticResource BoolVis}}"/>
        </Grid>

        <!-- Vue Drops -->
        <Grid Grid.Row="1" Visibility="{Binding IsDrops, Converter={StaticResource BoolVis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="18" Padding="14,8" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource BodyXB}">
                        <Run Text="Légendes droppées : "/><Run Text="{Binding Total, Mode=OneWay}" Foreground="{DynamicResource Accent}"/>
                    </TextBlock>
                </Border>
                <!-- Dernier drop : nom, durée écoulée et numéro du run actif à ce moment -->
                <Border Grid.Column="1" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="14" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DERNIER DROP" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                            <TextBlock Text="{Binding DropName}" FontFamily="{StaticResource BodyXB}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,14,0">
                            <TextBlock Text="DEPUIS" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding DropSince}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="15" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Grid.Column="2" Width="1" Background="{DynamicResource Line}" Margin="0,2,0,2"/>
                        <StackPanel Grid.Column="3" Margin="14,0,0,0">
                            <TextBlock Text="AU RUN N°" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding DropRun}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="15" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock Text="{Binding Strat.ActiveRunLine, StringFormat='Le numéro de run est celui du run actif ({0}) au moment où tu ajoutes une légende.'}"
                       Foreground="{DynamicResource Dim}" FontSize="12" Margin="4,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Top}" ItemTemplate="{StaticResource LegendRow}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Légendes animales" FontFamily="{StaticResource BodyXB}" FontSize="15"/>
            <TextBlock Text="4 légendes · compteur de chacune" Foreground="{DynamicResource Muted}" FontSize="12"/>
        </StackPanel>
        <Border Grid.Row="4" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Animal}" ItemTemplate="{StaticResource LegendRow}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="Légendes classiques" FontFamily="{StaticResource BodyXB}" FontSize="15"/>
            <TextBlock Text="26 légendes · compteur de chacune · fais défiler la liste" Foreground="{DynamicResource Muted}" FontSize="12"/>
        </StackPanel>
        <Border Grid.Row="6" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Visible">
                <ItemsControl ItemsSource="{Binding Classic}" ItemTemplate="{StaticResource LegendRow}"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="7" Margin="0,10,0,0" Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap"
                   Text="Noms relevés sur krosmolab.fr (Ressources des Songes, niveau 200), à recouper avec le jeu."/>
        </Grid>

        <!-- Vue Stats -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStats, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="0,0,0,12">
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Exporter les runs (CSV)" Command="{Binding ExportRunsCommand}" Margin="0,0,8,0" ToolTip="Ouvre-les ensuite dans Excel"/>
                        <Button Content="Exporter les drops (CSV)" Command="{Binding ExportDropsCommand}"/>
                    </StackPanel>
                    <TextBlock Text="Période des runs" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ListBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource Chip}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                </DockPanel>
                <WrapPanel>
                    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="LÉGENDES SUIVIES" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                            <TextBlock Text="{Binding StatTotal}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="20"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="RUNS COMPTÉS" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                            <TextBlock Text="{Binding StatRuns}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="20"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="MOYENNE PAR LÉGENDE" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                            <TextBlock Text="{Binding StatAverage}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="20"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="ÉCART DU DERNIER DROP" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                            <TextBlock Text="{Binding StatLastGap}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="20"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="RUNS DEPUIS LE DERNIER DROP" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                            <TextBlock Text="{Binding StatSince}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="20"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="PLUS LONG ÉCART" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                            <TextBlock Text="{Binding StatLongest}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="20"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="AUJOURD'HUI" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                            <TextBlock Text="{Binding StatToday}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="20"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="7 DERNIERS JOURS" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                            <TextBlock Text="{Binding StatWeek}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="20"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <TextBlock Text="Les statistiques comptent les légendes animales et classiques ajoutées depuis la version 0.12.0. Retirer une légende par erreur la retire aussi de l'historique."
                           Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,12"/>
                <!-- Ajouter une run : type, durée, vagues -->
                <TextBlock Text="Ajouter une run" FontFamily="{StaticResource BodyXB}" FontSize="15" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="TYPE" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding RunTypes}" SelectedItem="{Binding NewType, Mode=TwoWay}" Width="150"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="TEMPS (MIN:S)" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewTime, UpdateSourceTrigger=PropertyChanged}" Width="110" ToolTip="Par exemple 3:45">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddRunEntryCommand}"/></TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="VAGUES" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewWaves, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddRunEntryCommand}"/></TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="NOTE (FACULTATIF)" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" Width="190" MaxLength="120" ToolTip="Composition, stratégie, remarque…">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddRunEntryCommand}"/></TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <Button Content="{Binding SubmitLabel}" Command="{Binding AddRunEntryCommand}" VerticalAlignment="Bottom" Style="{StaticResource Big}"
                                    Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}"/>
                            <Button Content="Annuler" Command="{Binding CancelEditCommand}" VerticalAlignment="Bottom" Style="{StaticResource Big}" Margin="8,0,0,0"
                                    Visibility="{Binding IsEditingRun, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RunFormMessage}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,0,0,8">
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding RunTypes}" SelectedItem="{Binding ChartType, Mode=TwoWay}" Width="150"/>
                    <TextBlock Text="Progression" FontFamily="{StaticResource BodyXB}" FontSize="15" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Polyline Points="{Binding ChartPoints}" Stretch="Fill" Height="110" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                                  StrokeLineJoin="Round" Margin="0,4,0,8"
                                  Visibility="{Binding HasChart, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding ChartInfo}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Par type de run" FontFamily="{StaticResource BodyXB}" FontSize="15" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="10,6,10,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TYPE" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="RUNS" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="TEMPS MOYEN" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="MEILLEUR" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="VAGUES" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RunTypeStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Type}" FontFamily="{StaticResource BodyXB}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Count}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Average}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Best}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Waves}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Aucune run saisie sur cette période." Foreground="{DynamicResource Dim}" Margin="10,6,10,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRuns}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="Dernières runs" FontFamily="{StaticResource BodyXB}" FontSize="15" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding RecentRuns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontFamily="{StaticResource BodyXB}"/>
                                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Note, Converter={StaticResource NotEmptyVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Waves}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Since}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Content="✎" Command="{Binding EditCommand}" Width="28" Height="26" Padding="0" Margin="10,0,0,0" ToolTip="Modifier cette run"/>
                                    <Button Grid.Column="5" Content="✕" Command="{Binding DeleteCommand}" Width="28" Height="26" Padding="0" Margin="6,0,0,0" ToolTip="Supprimer cette run"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="Derniers drops" FontFamily="{StaticResource BodyXB}" FontSize="15" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="4">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding RecentDrops}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyXB}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Run}" Foreground="{DynamicResource Muted}" Margin="0,0,14,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Since}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Aucun drop enregistré pour l'instant : ajoute une légende dans la vue Drops." Foreground="{DynamicResource Dim}" Margin="10,10" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
