<UserControl x:Class="DofusTeamOrganizer.Views.RoutinesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DofusTeamOrganizer.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="40" HorizontalAlignment="Left" MinWidth="220"
                                 ToolTip="Clique pour renommer la tâche"/>
                        <TextBlock Text="{Binding ResetText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,4,0,0"/>
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="104">
                                    <CheckBox IsChecked="{Binding Done, Mode=TwoWay}" HorizontalAlignment="Center" ToolTip="{Binding CharName}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="2" Content="✕" Command="{Binding DeleteCommand}" ToolTip="Supprimer cette tâche" Width="30" Height="30" Padding="0" MinHeight="0"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Tâches" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Ce qu'il reste à faire, personnage par personnage · les remises à zéro sont automatiques" Style="{StaticResource PageSub}"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                <TextBlock Text="{Binding NextText}" Foreground="{DynamicResource Muted}" FontSize="12.5"/>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasDaily, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <Grid Margin="16,12,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tous les jours" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding CharNames}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Width="104" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"
                                                   Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="12.5"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DailyRows}" ItemTemplate="{StaticResource RowTemplate}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasWeekly, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <Grid Margin="16,12,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Une fois par semaine" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding CharNames}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Width="104" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"
                                                   Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="12.5"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding WeeklyRows}" ItemTemplate="{StaticResource RowTemplate}"/>
                    </StackPanel>
                </Border>
                <!-- Ajout -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ajouter une tâche" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <TextBox Width="260" MaxLength="40" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom de la tâche" Margin="0,0,10,8"/>
                            <ComboBox Width="200" ItemsSource="{x:Static vm:RoutineViewModel.FreqChoices}" SelectedIndex="{Binding NewFreq, Mode=TwoWay}" Margin="0,0,10,8"/>
                            <ComboBox Width="160" ItemsSource="{x:Static vm:RoutineViewModel.DayChoices}" SelectedIndex="{Binding NewDay, Mode=TwoWay}" Margin="0,0,10,8"
                                      Visibility="{Binding NewWeekly, Converter={StaticResource BoolVis}}"/>
                            <Button Content="Ajouter" Command="{Binding AddCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,10,8"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" FontSize="12.5"/>
                        <TextBlock Text="Remise à zéro : tous les jours à minuit, ou le jour choisi à 3 h du matin." Style="{StaticResource PageSub}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
