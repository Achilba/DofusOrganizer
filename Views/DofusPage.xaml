<UserControl x:Class="DofusTeamOrganizer.Views.DofusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="EggTileStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="12" Padding="6,8">
                            <Grid>
                                <Border x:Name="badge" Width="20" Height="20" CornerRadius="10" Background="{StaticResource Good}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0"
                                        Visibility="Collapsed">
                                    <Path Data="{StaticResource IcoCheck}" Stroke="{StaticResource GoodDark}" StrokeThickness="3.2" Stretch="Uniform" Width="11" Height="9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="34" Height="40" HorizontalAlignment="Center">
                                        <Canvas Width="40" Height="48">
                                            <Path Data="{StaticResource IcoEgg}" Fill="{Binding Color, Converter={StaticResource HexBrush}}" Stroke="#59FFFFFF" StrokeThickness="1.5"/>
                                            <Ellipse Canvas.Left="10" Canvas.Top="9" Width="8" Height="14" Fill="#59FFFFFF" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform><RotateTransform Angle="20"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyXB}" FontSize="14" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="st" Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="11.5" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#243DD68C"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Good}"/>
                                <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="st" Property="Foreground" Value="{StaticResource GoodText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="EggTile">
            <ToggleButton Style="{StaticResource EggTileStyle}" IsChecked="{Binding Done, Mode=TwoWay}" Margin="0,0,12,12"/>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
            <Grid Margin="0,0,0,14">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Dofus" Style="{StaticResource PageTitle}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Border Width="150" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MainCounter}" FontFamily="{StaticResource BodyXB}"/>
                                <TextBlock Text="Principaux" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </DockPanel>
                            <ProgressBar Style="{StaticResource Meter}" Value="{Binding MainPct, Mode=OneWay}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Width="150" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SpecialCounter}" FontFamily="{StaticResource BodyXB}"/>
                                <TextBlock Text="Particuliers" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </DockPanel>
                            <ProgressBar Style="{StaticResource Meter}" Foreground="{StaticResource Accent}" Value="{Binding SpecialPct, Mode=OneWay}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding MainDofus}" ItemTemplate="{StaticResource EggTile}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Dofus particuliers (repliable) -->
            <Button Command="{Binding ToggleSpecialCommand}" HorizontalContentAlignment="Stretch" Height="44" Margin="0,0,0,12" Padding="14,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line2}" BorderThickness="1" FontSize="14">
                <DockPanel LastChildFill="False">
                    <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IcoChevronRight}" Stroke="{StaticResource Text}" StrokeThickness="3" Width="14" Height="14" Margin="0,0,10,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="{Binding SpecOpen, Converter={StaticResource OpenAngle}}"/>
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock DockPanel.Dock="Left" Text="Dofus particuliers" FontFamily="{StaticResource BodyXB}" FontSize="14"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SpecialCounterSpaced}" Foreground="{StaticResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="14"/>
                </DockPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding SpecialDofus}" ItemTemplate="{StaticResource EggTile}" Margin="0,0,-12,0"
                          Visibility="{Binding SpecOpen, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Background="{StaticResource Panel}" BorderBrush="#4A5160" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                <TextBlock Text="Icônes provisoires : elles seront remplacées par les PNG officiels de DOFUS 3 une fois les fichiers fournis."
                           Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
