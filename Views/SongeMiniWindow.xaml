<Window x:Class="DofusTeamOrganizer.Views.SongeMiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOFUS Team Organizer (mini Songes)" Height="44" Width="700" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Foreground="{DynamicResource Text}" FontFamily="{StaticResource Body}" WindowStartupLocation="Manual"
        Opacity="{Binding MiniOpacity}">
    <Grid>
    <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Height="44" Margin="0"
            MouseLeftButtonDown="Drag_MouseLeftButtonDown">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <StackPanel Orientation="Horizontal" Margin="8,0">
            <!-- poignée -->
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoGrip}" Stroke="#6B7280" StrokeThickness="3" Width="8" Height="14" Margin="4,0,10,0" ToolTip="Glisser pour déplacer"/>

            <!-- Invitations -->
            <Button x:Name="InvitesBtn" Command="{Binding CopyInvitesCommand}" Height="32" MinHeight="0" Padding="12,0" Margin="0,0,8,0" FontSize="13"
                    Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}">
                <TextBlock Text="Invitations"/>
            </Button>
            <Popup PlacementTarget="{Binding ElementName=InvitesBtn}" Placement="Bottom" VerticalOffset="4" HorizontalOffset="0"
               AllowsTransparency="True" StaysOpen="True" Focusable="False" IsHitTestVisible="False">
            <Popup.Style>
                <Style TargetType="Popup">
                    <Setter Property="IsOpen" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Toast}" Value="">
                            <Setter Property="IsOpen" Value="False"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Toast}" Value="{x:Null}">
                            <Setter Property="IsOpen" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Popup.Style>
            <Border Height="32" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCheck}" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="COPIÉ" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                </StackPanel>
            </Border>
            </Popup>
            <Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="0,0,8,0"/>

            <!-- Type de run -->
            <ComboBox ItemsSource="{Binding Songes.Strat.Runs}" SelectedItem="{Binding Songes.Strat.Selected, Mode=TwoWay}"
                      MinWidth="160" Height="32" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Type de run">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- − compteur + -->
            <Button Content="−" Command="{Binding Songes.Strat.DecCommand}" IsEnabled="{Binding Songes.Strat.Selected.CanDec}"
                    Width="30" Height="32" MinHeight="0" Padding="0" Margin="0,0,2,0" ToolTip="Retirer un run"/>
            <TextBlock Text="{Binding Songes.Strat.Selected.Count}" MinWidth="34" TextAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{StaticResource BodyXB}" FontSize="18" Foreground="{DynamicResource Accent}"/>
            <Button Command="{Binding Songes.Strat.IncCommand}" Height="32" MinHeight="0" Padding="14,0" Margin="2,0,8,0" FontSize="14" ToolTip="Ajouter un run"
                    Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}">
                <TextBlock Text="+ Run" FontFamily="{StaticResource BodyXB}"/>
            </Button>

            <!-- Total du jour -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Runs ajoutés aujourd'hui (remis à zéro à minuit)">
                <TextBlock Text="Auj." Foreground="{DynamicResource Muted}" FontFamily="{StaticResource BodyXB}" FontSize="11"/>
                <TextBlock Text="{Binding Songes.Strat.TodayCountText}" FontFamily="{StaticResource BodyXB}" FontSize="13"/>
            </StackPanel>

            <!-- Retour à la fenêtre complète -->
            <Button Command="{Binding ShowMainCommand}" Width="32" Height="32" MinHeight="0" Padding="0" Margin="0" BorderBrush="{DynamicResource Text}"
                    ToolTip="Revenir à l'interface complète">
                <Grid>
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCompress}" Stroke="{DynamicResource Text}" Width="14" Height="14"/>
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Warn}" Stroke="{DynamicResource Side}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-13,-13,0"
                             ToolTip="Mise à jour disponible (Paramètres)"
                             Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
    <Thumb HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="10" Cursor="SizeWE" Focusable="False" FocusVisualStyle="{x:Null}"
           ToolTip="Tirer pour ajuster la taille de la barre"
           DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted">
        <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
                <Grid Background="Transparent">
                    <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Accent}" Opacity="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bar" Property="Opacity" Value="0.9"/>
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="bar" Property="Opacity" Value="0.9"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Thumb.Template>
    </Thumb>
    </Grid>
</Window>
