<UserControl x:Class="DofusTeamOrganizer.Views.ZaapPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="Box" Height="44" VerticalContentAlignment="Center"
                 TextChanged="Box_TextChanged" GotKeyboardFocus="Box_GotFocus" LostKeyboardFocus="Box_LostFocus"
                 PreviewKeyDown="Box_KeyDown"/>
        <TextBlock x:Name="Hint" Text="Zaap : Cania, Sufokia, -5,-23…  (copié dès le clic)" Foreground="{DynamicResource Dim}"
                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14"/>
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" StaysOpen="True"
               AllowsTransparency="True" Focusable="False">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line2}" BorderThickness="1.5"
                    TextElement.Foreground="{DynamicResource Text}" CornerRadius="8" Margin="0,4,0,0" Width="{Binding ActualWidth, ElementName=Box}" MaxHeight="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="NoMatch" Text="Aucun Zaap ne correspond." Foreground="{DynamicResource Dim}" Margin="12,10" Visibility="Collapsed"/>
                        <ItemsControl x:Name="ZList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Item_Click" Tag="{Binding}" Focusable="False" Background="Transparent"
                                            BorderThickness="0" Padding="12,7" HorizontalContentAlignment="Left">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="r" Background="Transparent" Padding="12,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Coord}" Foreground="{DynamicResource Dim}" Margin="12,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="r" Property="Background" Value="{DynamicResource Active}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
