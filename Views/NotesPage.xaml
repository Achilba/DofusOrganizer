<UserControl x:Class="DofusTeamOrganizer.Views.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Notes" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Un bloc-notes commun et un par personnage · recherche et cases à cocher" Style="{StaticResource PageSub}"/>
        </StackPanel>

        <!-- Onglets -->
        <ListBox Grid.Row="1" ItemsSource="{Binding NoteKeys}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource Chip}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>

        <!-- Recherche -->
        <TextBox Grid.Row="2" Text="{Binding NoteSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rechercher dans toutes les notes" Margin="0,0,0,14"/>

        <!-- Résultats -->
        <Border Grid.Row="3" Background="{StaticResource Side}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,14"
                MaxHeight="150" Visibility="{Binding SearchActive, Converter={StaticResource BoolVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Aucune note ne contient ce mot." Foreground="{StaticResource Dim}" Margin="14,10"
                               Visibility="{Binding HasNoteHits, Converter={StaticResource InvBoolVis}}"/>
                    <ItemsControl ItemsSource="{Binding NoteHits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BtnFlat}" HorizontalContentAlignment="Stretch" Padding="14,8"
                                        Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" Foreground="{StaticResource Accent}" FontFamily="{StaticResource BodyXB}" MinWidth="90"/>
                                        <TextBlock Text="{Binding Snippet}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bloc-notes -->
        <TextBox Grid.Row="4" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Background="{StaticResource Side}"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="16" FontSize="15" Margin="0,0,0,12" MinHeight="120"
                 ToolTip="Une ligne « - [ ] tâche » devient une case à cocher"/>

        <!-- Tâches -->
        <Border Grid.Row="5" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="+ Ajouter une case" Command="{Binding AddTaskCommand}" MinHeight="32" Padding="12,0" FontSize="12"/>
                    <TextBlock Text="{Binding TasksTitle}" FontFamily="{StaticResource BodyXB}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Aucune case dans cette note." Foreground="{StaticResource Dim}" FontSize="12"
                           Visibility="{Binding HasTasks, Converter={StaticResource InvBoolVis}}"/>
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Done, Mode=TwoWay}" Margin="0,3">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" TextDecorations="{Binding Done, Converter={StaticResource Strike}}"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCheck}" Stroke="{StaticResource GoodText}" StrokeThickness="2.5" Width="14" Height="14" Margin="0,0,8,0"/>
            <TextBlock Text="Enregistré automatiquement à chaque frappe" Foreground="{StaticResource GoodText}" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
